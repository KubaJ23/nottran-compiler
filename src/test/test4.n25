! Test program 3 (Corrected): Statements
! Tests all statement types.
! The 'type item' definition is now correctly at the top level.

! Define a derived type for field assignment test
type item
    integer :: id
end type item

program statement_test
    integer :: x, y, i, j
    integer(5) :: arr
    type (item) :: s
    logical :: check
    integer(*) pointer :: p

    read x, y

    ! Assignment statements
    arr(0) = x + y  ! Array element assignment
    s % id = 99     ! Derived type field assignment
    check = .true.

    ! If-then-else statement
    if (x > y) then
        write x
    else
        write y
    end if

    ! Simple if statement
    if (x == y) write "Equal!"

    ! Do loop (default step 1)
    do i = 0, 5
        arr(i) = i
    end do

    ! Do loop (explicit step)
    do j = 1, 10, 2
        write j
    end do

    ! Do-while loop
    do while (check .and. (x > 0))
        x = x - 1
        check = x > 0
    end do

    ! Allocate/Deallocate statements
    allocate p, 10
    p(0) = 100
    deallocate p

    ! Call statement
    call my_sub()

    ! Write statement
    write "Final:", x, s % id, arr(4)

end program statement_test

subroutine my_sub()
    ! not Empty sub
    write "yes"
end subroutine my_sub