    end if


    ! =========================================================================
    ! GROUP 18: TYPE MIXING IN OPERATIONS
    ! =========================================================================
    write ""
    write "========== GROUP 18: REMOVED (TYPE MIXING WITH REALS) =========="

    ! --- Test 18.1: REMOVED ---
    ! --- Test 18.2: REMOVED ---


    ! =========================================================================
    ! GROUP 19: SPECIAL OPERATOR CASES
    ! =========================================================================
    write ""
    write "========== GROUP 19: SPECIAL OPERATORS =========="

    ! --- Test 19.1: Field access precedence ---
    test_count = test_count + 1
    test_name = "Field access precedence"

    p1%position%x = 10
    p1%position%y = 5

    int_var = p1%position%x + p1%position%y * 2

    ! 10 + 5*2 = 10 + 10 = 20
    if (int_var == 20) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 19.2: Multiple concatenations ---
    test_count = test_count + 1
    test_name = "Multiple concat"

    str_var = "A" // "B" // "C" // "D"

    if (str_var == "ABCD") then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 19.3: Comparison chain (separate) ---
    test_count = test_count + 1
    test_name = "Comparison chain"

    int_a = 5
    bool_a = int_a > 3
    bool_b = int_a < 10
    bool_var = bool_a .and. bool_b

    if (bool_var == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 20: STRESS TESTS
    ! =========================================================================
    write ""
    write "========== GROUP 20: STRESS TESTS =========="

    ! --- Test 20.1: Large factorial ---
    test_count = test_count + 1
    test_name = "Large factorial"

    func_result = factorial(10)

    if (func_result == 3628800) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 20.2: Deep recursion ---
    test_count = test_count + 1
    test_name = "Deep recursion"

    func_result = fibonacci(10)

    if (func_result == 55) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 20.3: Many loop iterations ---
    test_count = test_count + 1
    test_name = "Many iterations"

    sum_val = 0
    do i = 0, 1000
        sum_val = sum_val + 1
    end do

    if (sum_val == 1000) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 20.4: Large array allocation ---
    test_count = test_count + 1
    test_name = "Large array alloc"

    allocate dyn_array, 1000

    dyn_array(0) = 1
    dyn_array(500) = 2
    dyn_array(999) = 3

    sum_val = dyn_array(0) + dyn_array(500) + dyn_array(999)

    deallocate dyn_array

    if (sum_val == 6) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 20.5: Large 2D array ---
    test_count = test_count + 1
    test_name = "Large 2D array"

    allocate dyn_2d, 50, 50

    dyn_2d(0, 0) = 1
    dyn_2d(25, 25) = 2
    dyn_2d(49, 49) = 3

    sum_val = dyn_2d(0, 0) + dyn_2d(25, 25) + dyn_2d(49, 49)

    deallocate dyn_2d

    if (sum_val == 6) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! FINAL SUMMARY
    ! =========================================================================
    write ""
    write ""
    write "============================================="
    write " TEST SUITE COMPLETE"
    write "============================================="
    write ""
    write "Total tests:", test_count
    write "Passed:", pass_count
    write "Failed:", fail_count
    write ""

    if (fail_count == 0) then
        write "  *** ALL TESTS PASSED ***"
        write "  Nottran compiler is working correctly!"
    else
        write "  !!! SOME TESTS FAILED !!!"
        write "  Please review the failures above."
    end if

    write ""
    write "============================================="

end program comprehensive_test