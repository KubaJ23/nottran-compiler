! =============================================================================
! COMPREHENSIVE NOTTRAN LANGUAGE TEST SUITE (NO REALS)
! =============================================================================
! This suite rigorously tests ALL features of the Nottran specification (EXCEPT REALS):
!   - Literal types (integers, logical, characters, BOZ literals)
!   - Operators (arithmetic, relational, logical, concatenation)
!   - Statement types (assignment, if, do, while, read/write, alloc/dealloc)
!   - Functions and subroutines (recursive and non-recursive)
!   - Derived types with various combinations
!   - Arrays (static and dynamic, 1D/2D/3D)
!   - Operator precedence and associativity
!   - Edge cases and complex combinations
! =============================================================================

! --- DERIVED TYPE DEFINITIONS ---

type coord
    integer :: x, y
end type coord

type particle
    integer :: mass
    type(coord) :: position
    logical :: active
end type particle

type matrix_element
    integer :: row, col
    integer :: value
end type matrix_element

type container
    integer(5) :: data
    character :: label
end type container


! --- UTILITY FUNCTIONS FOR TESTING ---

! Test integer arithmetic operators
function test_arithmetic(a, b) result(r)
    integer :: a, b, r
    integer :: add, sub, mul, div, exp

    add = a + b
    sub = a - b
    mul = a * b
    div = a / b
    exp = a ** 2

    ! Verify basic operations
    r = 0
    if (add /= (a + b)) then
        r = 1
    end if
    if (sub /= (a - b)) then
        r = 2
    end if
    if (mul /= (a * b)) then
        r = 3
    end if
end function test_arithmetic

! Test logical operators
function test_logical(p, q) result(ok)
    logical :: p, q, ok
    logical :: and_result, or_result

    and_result = p .and. q
    or_result = p .or. q

    ok = .true.
    if (p == .true.) then
        if (q == .true.) then
            if (and_result /= .true.) then
                ok = .false.
            end if
            if (or_result /= .true.) then
                ok = .false.
            end if
        else
            if (and_result /= .false.) then
                ok = .false.
            end if
            if (or_result /= .true.) then
                ok = .false.
            end if
        end if
    end if
end function test_logical

! Test relational operators (both symbolic and textual forms)
function test_relational(a, b) result(r)
    integer :: a, b, r
    logical :: lt, le, gt, ge, eq, ne
    logical :: lt2, le2, gt2, ge2, eq2, ne2

    ! Symbolic forms
    lt = a < b
    le = a <= b
    gt = a > b
    ge = a >= b
    eq = a == b
    ne = a /= b

    ! Textual forms
    lt2 = a .lt. b
    le2 = a .le. b
    gt2 = a .gt. b
    ge2 = a .ge. b
    eq2 = a .eq. b
    ne2 = a .neq. b

    ! Verify they match
    r = 0
    if (lt /= lt2) then
        r = 1
    end if
    if (le /= le2) then
        r = 2
    end if
    if (gt /= gt2) then
        r = 3
    end if
    if (ge /= ge2) then
        r = 4
    end if
    if (eq /= eq2) then
        r = 5
    end if
    if (ne /= ne2) then
        r = 6
    end if
end function test_relational

! Recursive factorial function
function factorial(n) result(f)
    integer :: n, f

    if (n <= 1) then
        f = 1
    else
        f = n * factorial(n - 1)
    end if
end function factorial

! Recursive Fibonacci
function fibonacci(n) result(fib)
    integer :: n, fib

    if (n <= 1) then
        fib = n
    else
        fib = fibonacci(n - 1) + fibonacci(n - 2)
    end if
end function fibonacci

! Test operator precedence
function test_precedence() result(r)
    integer :: r
    integer :: x, y, z

    ! Test: 2 + 3 * 4 should be 14, not 20
    x = 2 + 3 * 4

    ! Test: 2 * 3 + 4 should be 10
    y = 2 * 3 + 4

    ! Test: (2 + 3) * 4 should be 20
    z = (2 + 3) * 4

    r = 0
    if (x /= 14) then
        r = 1
    end if
    if (y /= 10) then
        r = 2
    end if
    if (z /= 20) then
        r = 3
    end if
end function test_precedence

! Test exponentiation associativity (right-associative)
function test_exponent() result(r)
    integer :: r
    integer :: x, y

    ! 2 ** 3 ** 2 should be 2 ** 9 = 512 (right-associative)
    ! NOT (2 ** 3) ** 2 = 8 ** 2 = 64
    x = 2 ** 3 ** 2

    ! Verify
    y = 2 ** 9

    r = 0
    if (x /= y) then
        r = 1
    end if
    if (x /= 512) then
        r = 2
    end if
end function test_exponent

! Test array operations
function sum_array(arr, size) result(total)
    integer(*) pointer :: arr
    integer :: size, total
    integer :: i

    total = 0
    do i = 0, size
        total = total + arr(i)
    end do
end function sum_array

! Test 2D array operations
function sum_2d_array(arr, rows, cols) result(total)
    integer(*, *) pointer :: arr
    integer :: rows, cols, total
    integer :: i, j

    total = 0
    do i = 0, rows
        do j = 0, cols
            total = total + arr(i, j)
        end do
    end do
end function sum_2d_array

! Subroutine to modify a value (tests pass-by-value)
subroutine try_modify(x)
    integer :: x
    x = 999
end subroutine try_modify

! Subroutine to fill an array
subroutine fill_array(arr, size, value)
    integer(*) pointer :: arr
    integer :: size, value
    integer :: i

    do i = 0, size
        arr(i) = value
    end do
end subroutine fill_array


! --- MAIN TEST PROGRAM ---

program comprehensive_test
    ! === VARIABLE DECLARATIONS ===

    ! Basic types
    integer :: int_var, int_a, int_b, int_result
    ! REMOVED: real :: real_var, real_a, real_b
    logical :: bool_var, bool_a, bool_b
    character :: char_var, str_var

    ! BOZ literals
    integer :: binary_val, octal_val, hex_val

    ! Arrays
    integer(10) :: static_array
    integer(3, 4) :: static_2d
    integer(2, 3, 2) :: static_3d

    ! Dynamic arrays
    integer(*) pointer :: dyn_array
    integer(*, *) pointer :: dyn_2d

    ! Derived types
    type(coord) :: point1, point2
    type(particle) :: p1, p2
    type(particle)(3) :: particle_array
    type(matrix_element)(*, *) pointer :: matrix
    type(container) :: box

    ! Loop counters and test tracking
    integer :: i, j, k, idx
    integer :: test_count, pass_count, fail_count
    logical :: test_passed
    character :: test_name

    ! Function results
    integer :: func_result
    logical :: bool_result

    ! Temporary variables
    integer :: temp1, temp2, temp3
    integer :: sum_val


    ! === INITIALIZATION ===
    test_count = 0
    pass_count = 0
    fail_count = 0

    write "============================================="
    write " NOTTRAN COMPREHENSIVE LANGUAGE TEST SUITE"
    write " (NO REALS VERSION)"
    write "============================================="
    write ""


    ! =========================================================================
    ! GROUP 1: LITERAL CONSTANTS
    ! =========================================================================
    write "========== GROUP 1: LITERAL CONSTANTS =========="

    ! --- Test 1.1: Decimal integers ---
    test_count = test_count + 1
    test_name = "Decimal integers"

    int_a = 42
    int_b = -17
    temp1 = +100

    test_passed = .true.
    if (int_a /= 42) then
        test_passed = .false.
    end if
    if (int_b /= -17) then
        test_passed = .false.
    end if
    if (temp1 /= 100) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 1.2: BOZ literals ---
    test_count = test_count + 1
    test_name = "BOZ literals"

    binary_val = b"1010"
    octal_val = o"17"
    hex_val = z"2a"

    test_passed = .true.
    if (binary_val /= 10) then
        test_passed = .false.
    end if
    if (octal_val /= 15) then
        test_passed = .false.
    end if
    if (hex_val /= 42) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 1.3: REMOVED (Real numbers) ---


    ! --- Test 1.4: Logical values ---
    test_count = test_count + 1
    test_name = "Logical values"

    bool_a = .true.
    bool_b = .false.

    test_passed = .true.
    if (bool_a /= .true.) then
        test_passed = .false.
    end if
    if (bool_b == .true.) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 1.5: Character literals ---
    test_count = test_count + 1
    test_name = "Character literals"

    char_var = "X"
    str_var = "Hello, World!"

    test_passed = .true.
    if (char_var /= "X") then
        test_passed = .false.
    end if
    if (str_var /= "Hello, World!") then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 1.6: Escaped quotes in strings ---
    test_count = test_count + 1
    test_name = "Escaped quotes"

    str_var = "She said ""Hello"""

    test_passed = .true.
    if (str_var == "She said ""Hello""") then
        test_passed = .true.
    else
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 2: ARITHMETIC OPERATORS
    ! =========================================================================
    write ""
    write "========== GROUP 2: ARITHMETIC OPERATORS =========="

    ! --- Test 2.1: Basic arithmetic ---
    test_count = test_count + 1
    test_name = "Basic arithmetic"

    int_a = 10
    int_b = 3

    temp1 = int_a + int_b
    temp2 = int_a - int_b
    temp3 = int_a * int_b

    test_passed = .true.
    if (temp1 /= 13) then
        test_passed = .false.
    end if
    if (temp2 /= 7) then
        test_passed = .false.
    end if
    if (temp3 /= 30) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 2.2: Integer division ---
    test_count = test_count + 1
    test_name = "Integer division"

    temp1 = 10 / 3
    temp2 = 9 / 3
    temp3 = 7 / 2

    test_passed = .true.
    if (temp1 /= 3) then
        test_passed = .false.
    end if
    if (temp2 /= 3) then
        test_passed = .false.
    end if
    if (temp3 /= 3) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 2.3: Exponentiation ---
    test_count = test_count + 1
    test_name = "Exponentiation"

    temp1 = 2 ** 3
    temp2 = 5 ** 2
    temp3 = 3 ** 4

    test_passed = .true.
    if (temp1 /= 8) then
        test_passed = .false.
    end if
    if (temp2 /= 25) then
        test_passed = .false.
    end if
    if (temp3 /= 81) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 2.4: Operator precedence ---
    test_count = test_count + 1
    test_name = "Operator precedence"

    func_result = test_precedence()

    if (func_result == 0) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 2.5: Exponent associativity ---
    test_count = test_count + 1
    test_name = "Exponent associativity"

    func_result = test_exponent()

    if (func_result == 0) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 3: RELATIONAL OPERATORS
    ! =========================================================================
    write ""
    write "========== GROUP 3: RELATIONAL OPERATORS =========="

    ! --- Test 3.1: Symbolic relational operators ---
    test_count = test_count + 1
    test_name = "Symbolic relational ops"

    int_a = 5
    int_b = 10

    test_passed = .true.
    if ((int_a < int_b) /= .true.) then
        test_passed = .false.
    end if
    if ((int_a > int_b) == .true.) then
        test_passed = .false.
    end if
    if ((int_a == int_b) == .true.) then
        test_passed = .false.
    end if
    if ((int_a /= int_b) /= .true.) then
        test_passed = .false.
    end if
    if ((int_a <= int_b) /= .true.) then
        test_passed = .false.
    end if
    if ((int_a >= int_b) == .true.) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 3.2: Textual relational operators ---
    test_count = test_count + 1
    test_name = "Textual relational ops"

    test_passed = .true.
    if ((int_a .lt. int_b) /= .true.) then
        test_passed = .false.
    end if
    if ((int_a .gt. int_b) == .true.) then
        test_passed = .false.
    end if
    if ((int_a .eq. int_b) == .true.) then
        test_passed = .false.
    end if
    if ((int_a .neq. int_b) /= .true.) then
        test_passed = .false.
    end if
    if ((int_a .le. int_b) /= .true.) then
        test_passed = .false.
    end if
    if ((int_a .ge. int_b) == .true.) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 3.3: Consistency between forms ---
    test_count = test_count + 1
    test_name = "Relational consistency"

    func_result = test_relational(5, 10)

    if (func_result == 0) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 4: LOGICAL OPERATORS
    ! =========================================================================
    write ""
    write "========== GROUP 4: LOGICAL OPERATORS =========="

    ! --- Test 4.1: AND operator ---
    test_count = test_count + 1
    test_name = "Logical AND"

    test_passed = .true.
    if ((.true. .and. .true.) /= .true.) then
        test_passed = .false.
    end if
    if ((.true. .and. .false.) /= .false.) then
        test_passed = .false.
    end if
    if ((.false. .and. .true.) /= .false.) then
        test_passed = .false.
    end if
    if ((.false. .and. .false.) /= .false.) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 4.2: OR operator ---
    test_count = test_count + 1
    test_name = "Logical OR"

    test_passed = .true.
    if ((.true. .or. .true.) /= .true.) then
        test_passed = .false.
    end if
    if ((.true. .or. .false.) /= .true.) then
        test_passed = .false.
    end if
    if ((.false. .or. .true.) /= .true.) then
        test_passed = .false.
    end if
    if ((.false. .or. .false.) /= .false.) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 4.3: Combined logical operations ---
    test_count = test_count + 1
    test_name = "Combined logical ops"

    bool_result = test_logical(.true., .false.)

    if (bool_result == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 5: CHARACTER OPERATIONS
    ! =========================================================================
    write ""
    write "========== GROUP 5: CHARACTER OPERATIONS =========="

    ! --- Test 5.1: String concatenation ---
    test_count = test_count + 1
    test_name = "String concatenation"

    str_var = "Hello" // " " // "World"

    if (str_var == "Hello World") then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 5.2: Lexicographic comparison ---
    test_count = test_count + 1
    test_name = "String comparison"

    test_passed = .true.
    if (("abc" < "def") /= .true.) then
        test_passed = .false.
    end if
    if (("xyz" > "abc") /= .true.) then
        test_passed = .false.
    end if
    if (("test" == "test") /= .true.) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 6: CONTROL FLOW - IF STATEMENTS
    ! =========================================================================
    write ""
    write "========== GROUP 6: IF STATEMENTS =========="

    ! --- Test 6.1: Simple if statement ---
    test_count = test_count + 1
    test_name = "Simple if"

    int_var = 0
    if (.true.) int_var = 1

    if (int_var == 1) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 6.2: If-then-else ---
    test_count = test_count + 1
    test_name = "If-then-else"

    int_var = 0
    if (5 > 10) then
        int_var = 1
    else
        int_var = 2
    end if

    if (int_var == 2) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 6.3: Nested if statements ---
    test_count = test_count + 1
    test_name = "Nested if"

    int_var = 0
    if (5 < 10) then
        if (3 < 7) then
            int_var = 42
        else
            int_var = 1
        end if
    else
        int_var = 2
    end if

    if (int_var == 42) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 7: CONTROL FLOW - DO LOOPS
    ! =========================================================================
    write ""
    write "========== GROUP 7: DO LOOPS =========="

    ! --- Test 7.1: Basic do loop (step = 1) ---
    test_count = test_count + 1
    test_name = "Basic do loop"

    sum_val = 0
    do i = 0, 10
        sum_val = sum_val + i
    end do

    ! Sum of 0..9 = 45
    if (sum_val == 45) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 7.2: Do loop with step ---
    test_count = test_count + 1
    test_name = "Do loop with step"

    sum_val = 0
    do i = 0, 10, 2
        sum_val = sum_val + i
    end do

    ! Sum of 0,2,4,6,8 = 20
    if (sum_val == 20) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 7.3: Nested do loops ---
    test_count = test_count + 1
    test_name = "Nested do loops"

    sum_val = 0
    do i = 0, 3
        do j = 0, 3
            sum_val = sum_val + 1
        end do
    end do

    ! 3 * 3 = 9 iterations
    if (sum_val == 9) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 8: CONTROL FLOW - DO-WHILE LOOPS
    ! =========================================================================
    write ""
    write "========== GROUP 8: DO-WHILE LOOPS =========="

    ! --- Test 8.1: Basic do-while ---
    test_count = test_count + 1
    test_name = "Basic do-while"

    int_var = 0
    sum_val = 0
    do while (int_var < 5)
        sum_val = sum_val + int_var
        int_var = int_var + 1
    end do

    ! Sum of 0,1,2,3,4 = 10
    if (sum_val == 10) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 8.2: Do-while with complex condition ---
    test_count = test_count + 1
    test_name = "Do-while complex"

    int_a = 0
    int_b = 10
    do while (int_a < 5 .and. int_b > 5)
        int_a = int_a + 1
        int_b = int_b - 1
    end do

    test_passed = .true.
    if (int_a /= 5) then
        test_passed = .false.
    end if
    if (int_b /= 5) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 9: ARRAYS - STATIC
    ! =========================================================================
    write ""
    write "========== GROUP 9: STATIC ARRAYS =========="

    ! --- Test 9.1: 1D array operations ---
    test_count = test_count + 1
    test_name = "Static 1D array"

    do i = 0, 10
        static_array(i) = i * 2
    end do

    test_passed = .true.
    if (static_array(0) /= 0) then
        test_passed = .false.
    end if
    if (static_array(5) /= 10) then
        test_passed = .false.
    end if
    if (static_array(9) /= 18) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 9.2: 2D array operations ---
    test_count = test_count + 1
    test_name = "Static 2D array"

    do i = 0, 3
