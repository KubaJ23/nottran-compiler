! Test for nested derived types, pointers, and complex function calls.

type image
    integer(10,10) :: grid
    character :: name
end type image

type screen
    integer :: id
    type(image) :: name ! Field 'name' is of type 'image'
end type screen

! --- Takes a STATIC image struct by value and sums its grid ---
function sum_grid(img) result(total)
    type(image) :: img
    integer :: total, i, j

    total = 0
    do i = 0, 10
        do j = 0, 10
            total = total + img % grid(i, j)
        end do
    end do
end function sum_grid

! --- Takes a POINTER to a screen and MODIFIES its data ---
subroutine modify_via_ptr(p)
    type(screen) pointer :: p
    p % id = 777 ! This change SHOULD affect the caller
end subroutine modify_via_ptr

! --- Takes a POINTER, re-allocates it, and modifies the NEW data ---
subroutine reallocate_ptr(p)
    type(screen) pointer :: p
    allocate p ! This allocates a NEW struct for the local 'p'
    p % id = 999 ! This change should NOT affect the caller
end subroutine reallocate_ptr


! --- Main Program ---
program nested_type_test
    integer :: i, failures, sum
    type(screen) :: static_item
    type(screen) pointer :: p_item

    failures = 0
    write "===== Running Nested Type Test ====="

    ! --- 1. Test Static Nested Assignment & Function Call ---
    write "--- 1. Static Test ---"
    static_item % id = 1
    static_item % name % name = "Static Image"
    static_item % name % grid(2, 2) = 100

    sum = sum_grid(static_item % name)
    write "Static Grid Sum (Exp. 100):", sum
    if (sum /= 100) then
        failures = failures + 1
    end if

    ! --- 2. Test Pointer Nested Assignment & Function Call ---
    write "--- 2. Pointer Test ---"
    allocate p_item

    p_item % id = 2
    p_item % name % name = "Pointer Image"
    p_item % name % grid(3, 3) = 200

    ! This tests passing a complex RValue (p_item % name) by value
    sum = sum_grid(p_item % name)
    write "Pointer Grid Sum (Exp. 200):", sum
    if (sum /= 200) then
        failures = failures + 1
    end if

    ! --- 3. Test Pass-By-Value (Pointer Data Modification) ---
    write "--- 3. Pointer Data Modification Test ---"
    call modify_via_ptr(p_item)
    write "Pointer ID after modify (Exp. 777):", p_item % id
    if (p_item % id /= 777) then
        failures = failures + 1
    end if

    ! --- 4. Test Pass-By-Value (Pointer Re-allocation) ---
    write "--- 4. Pointer Re-allocation Test ---"
    call reallocate_ptr(p_item)
    write "Pointer ID after reallocate (Exp. 777):", p_item % id
    if (p_item % id /= 777) then
        failures = failures + 1
    end if

    deallocate p_item

    write "===== Test Complete ====="
    write "Total Failures:", failures

end program nested_type_test