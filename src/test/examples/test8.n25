type student
    character :: name
    integer :: score
end type student

subroutine read_students(ptr, n)
    type(student)(*) pointer :: ptr
    integer :: n, i
    write "Enter student names and scores:"
    do i = 0, n
        read ptr(i) % name, ptr(i) % score
    end do
end subroutine read_students

function top_score(ptr, n) result(best)
    type(student)(*) pointer :: ptr
    integer :: n, best, i
    best = 0
    do i = 0, n
        if (ptr(i) % score > best) then
            best = ptr(i) % score
        end if
    end do
end function top_score

program student_scores
    type(student)(*) pointer :: arr
    integer :: n, best
    write "Number of students:"
    read n
    allocate arr, n
    call read_students(arr, n)
    best = top_score(arr, n)
    write "Highest score is:"
    write best
    deallocate arr
end program student_scores
