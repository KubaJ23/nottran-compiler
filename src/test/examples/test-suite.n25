    test_name = "Zero exponent"

    int_var = 5 ** 0

    if (int_var == 1) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 15.3: Single iteration loop ---
    test_count = test_count + 1
    test_name = "Single iteration loop"

    int_var = 0
    do i = 5, 6
        int_var = int_var + 1
    end do

    if (int_var == 1) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 15.4: Zero iterations loop ---
    test_count = test_count + 1
    test_name = "Zero iterations loop"

    int_var = 0
    do i = 10, 10
        int_var = int_var + 1
    end do

    if (int_var == 0) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 15.5: Large step loop ---
    test_count = test_count + 1
    test_name = "Large step loop"

    int_var = 0
    do i = 0, 100, 50
        int_var = int_var + 1
    end do

    if (int_var == 2) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 15.6: Negative numbers ---
    test_count = test_count + 1
    test_name = "Negative numbers"

    int_a = -5
    int_b = -3
    int_var = int_a + int_b

    if (int_var == -8) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 15.7: Empty string ---
    test_count = test_count + 1
    test_name = "Empty string"

    str_var = ""

    if (str_var == "") then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 16: STRESS TESTS
    ! =========================================================================
    write ""
    write "========== GROUP 16: STRESS TESTS =========="

    ! --- Test 16.1: Large factorial ---
    test_count = test_count + 1
    test_name = "Large factorial"

    func_result = factorial(10)

    if (func_result == 3628800) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 16.2: Deep recursion ---
    test_count = test_count + 1
    test_name = "Deep recursion"

    func_result = fibonacci(10)

    if (func_result == 55) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 16.3: Many iterations ---
    test_count = test_count + 1
    test_name = "Many iterations"

    sum_val = 0
    do i = 0, 1000
        sum_val = sum_val + 1
    end do

    if (sum_val == 1000) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 16.4: Large array ---
    test_count = test_count + 1
    test_name = "Large array"

    allocate dyn_array, 1000

    dyn_array(0) = 1
    dyn_array(500) = 2
    dyn_array(999) = 3

    sum_val = dyn_array(0) + dyn_array(500) + dyn_array(999)

    deallocate dyn_array

    if (sum_val == 6) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 16.5: Large 2D array ---
    test_count = test_count + 1
    test_name = "Large 2D array"

    allocate dyn_2d, 50, 50

    dyn_2d(0, 0) = 1
    dyn_2d(25, 25) = 2
    dyn_2d(49, 49) = 3

    sum_val = dyn_2d(0, 0) + dyn_2d(25, 25) + dyn_2d(49, 49)

    deallocate dyn_2d

    if (sum_val == 6) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 17: ASSIGNMENT VARIATIONS
    ! =========================================================================
    write ""
    write "========== GROUP 17: ASSIGNMENT VARIATIONS =========="

    ! --- Test 17.1: Sequential assignments ---
    test_count = test_count + 1
    test_name = "Sequential assignments"

    int_a = 5
    int_b = int_a
    int_var = int_b

    if (int_var == 5) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 17.2: Array element assign ---
    test_count = test_count + 1
    test_name = "Array element assign"

    static_array(5) = 100
    int_var = static_array(5)

    if (int_var == 100) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 17.3: 2D array assign ---
    test_count = test_count + 1
    test_name = "2D array assign"

    static_2d(2, 3) = 999
    int_var = static_2d(2, 3)

    if (int_var == 999) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 17.4: Derived field assign ---
    test_count = test_count + 1
    test_name = "Derived field assign"

    point1%x = 50
    int_var = point1%x

    if (int_var == 50) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 17.5: Nested derived assign ---
    test_count = test_count + 1
    test_name = "Nested derived assign"

    p1%position%x = 123
    int_var = p1%position%x

    if (int_var == 123) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 17.6: Array derived assign ---
    test_count = test_count + 1
    test_name = "Array derived assign"

    particle_array(2)%mass = 7
    temp1 = particle_array(2)%mass

    if (temp1 == 7) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 18: COMPLEX EXPRESSIONS
    ! =========================================================================
    write ""
    write "========== GROUP 18: COMPLEX EXPRESSIONS =========="

    ! --- Test 18.1: Mixed operators ---
    test_count = test_count + 1
    test_name = "Mixed operators"

    int_var = 2 + 3 * 4 - 5

    if (int_var == 9) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 18.2: Complex logical expr ---
    test_count = test_count + 1
    test_name = "Complex logical expr"

    bool_var = (5 < 10) .and. (3 > 1) .or. (7 == 8)

    if (bool_var == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 18.3: Nested parentheses ---
    test_count = test_count + 1
    test_name = "Nested parentheses"

    int_var = ((2 + 3) * (4 + 5)) / 3

    if (int_var == 15) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 18.4: Multiple conditions ---
    test_count = test_count + 1
    test_name = "Multiple conditions"

    int_a = 10
    int_b = 20
    int_var = 15

    bool_var = (int_var > int_a) .and. (int_var < int_b)

    if (bool_var == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 18.5: Comparison chain ---
    test_count = test_count + 1
    test_name = "Comparison chain"

    int_a = 5
    bool_a = int_a > 3
    bool_b = int_a < 10
    bool_var = bool_a .and. bool_b

    if (bool_var == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 19: MULTIDIMENSIONAL DERIVED TYPE ARRAYS
    ! =========================================================================
    write ""
    write "========== GROUP 19: MULTIDIM DERIVED ARRAYS =========="

    ! --- Test 19.1: Static array of vec3 ---
    test_count = test_count + 1
    test_name = "Static vec3 array"

    static_vec_array(0)%x = 1
    static_vec_array(0)%y = 2
    static_vec_array(0)%z = 3

    static_vec_array(4)%x = 10
    static_vec_array(4)%y = 20
    static_vec_array(4)%z = 30

    test_passed = .true.
    if (static_vec_array(0)%x /= 1) then
        test_passed = .false.
    end if
    if (static_vec_array(0)%z /= 3) then
        test_passed = .false.
    end if
    if (static_vec_array(4)%y /= 20) then
        test_passed = .false.
    end if

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 19.2: Dynamic 2D vec3 array ---
    test_count = test_count + 1
    test_name = "Dynamic 2D vec3 array"

    allocate dyn_vec_2d, 3, 4

    dyn_vec_2d(0, 0)%x = 100
    dyn_vec_2d(0, 0)%y = 200
    dyn_vec_2d(0, 0)%z = 300

    dyn_vec_2d(2, 3)%x = 999
    dyn_vec_2d(2, 3)%y = 888
    dyn_vec_2d(2, 3)%z = 777

    dyn_vec_2d(1, 2)%x = 50
    dyn_vec_2d(1, 2)%y = 60
    dyn_vec_2d(1, 2)%z = 70

    test_passed = .true.
    if (dyn_vec_2d(0, 0)%y /= 200) then
        test_passed = .false.
    end if
    if (dyn_vec_2d(2, 3)%x /= 999) then
        test_passed = .false.
    end if
    if (dyn_vec_2d(1, 2)%z /= 70) then
        test_passed = .false.
    end if

    deallocate dyn_vec_2d

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 19.3: Matrix with diagonal check ---
    test_count = test_count + 1
    test_name = "Matrix diagonal check"

    allocate matrix, 5, 5

    do i = 0, 5
        do j = 0, 5
            matrix(i, j)%row = i
            matrix(i, j)%col = j
            matrix(i, j)%value = 0

            if (i == j) then
                matrix(i, j)%value = 1
            end if
        end do
    end do

    test_passed = .true.
    if (matrix(0, 0)%value /= 1) then
        test_passed = .false.
    end if
    if (matrix(2, 2)%value /= 1) then
        test_passed = .false.
    end if
    if (matrix(1, 3)%value /= 0) then
        test_passed = .false.
    end if

    deallocate matrix

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! GROUP 20: COMPREHENSIVE INTEGRATION
    ! =========================================================================
    write ""
    write "========== GROUP 20: INTEGRATION TESTS =========="

    ! --- Test 20.1: Everything combined ---
    test_count = test_count + 1
    test_name = "Everything combined"

    allocate p_item
    p_item%id = b"1111"
    p_item%name = "Magic " // "Sword"
    p_item%sales_history(0) = 5
    p_item%sales_history(1) = 10
    p_item%sales_history(2) = 15

    pass_val = 99
    call pass_by_value_test(pass_val)

    total_sales = 0
    i = 0
    do while (i < 3)
        total_sales = total_sales + p_item%sales_history(i)
        i = i + 1
    end do

    if (factorial(4) == 24) then
        if (pass_val == 99) then
            if (total_sales == 30) then
                if (p_item%id == 15) then
                    test_passed = .true.
                else
                    test_passed = .false.
                end if
            else
                test_passed = .false.
            end if
        else
            test_passed = .false.
        end if
    else
        test_passed = .false.
    end if

    deallocate p_item

    if (test_passed == .true.) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 20.2: Nested structures stress ---
    test_count = test_count + 1
    test_name = "Nested structures stress"

    do i = 0, 3
        particle_array(i)%mass = i
        particle_array(i)%position%x = i * 10
        particle_array(i)%position%y = i * 20

        if (i < 2) then
            particle_array(i)%active = .true.
        else
            particle_array(i)%active = .false.
        end if
    end do

    sum_val = 0
    do i = 0, 3
        if (particle_array(i)%active == .true.) then
            sum_val = sum_val + (particle_array(i)%position%x + particle_array(i)%position%y)
        end if
    end do

    if (sum_val == 30) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! --- Test 20.3: All operators in one ---
    test_count = test_count + 1
    test_name = "All operators"

    int_a = 10
    int_b = 3
    bool_a = .true.
    bool_b = .false.
    str_var = "Test"

    int_var = ((int_a + int_b) * 2 - int_a / int_b) ** 2

    if ((int_var == 529) .and. (bool_a .or. bool_b) .and. (str_var == "Test")) then
        write "PASS:", test_name
        pass_count = pass_count + 1
    else
        write "FAIL:", test_name
        fail_count = fail_count + 1
    end if


    ! =========================================================================
    ! FINAL SUMMARY
    ! =========================================================================
    write ""
    write ""
    write "============================================="
    write " ULTIMATE TEST SUITE COMPLETE"
    write "============================================="
    write ""
    write "Total tests run:", test_count
    write "Tests passed:", pass_count
    write "Tests failed:", fail_count
    write ""

    if (fail_count == 0) then
        write "  *** ALL TESTS PASSED ***"
        write "  Nottran compiler is fully functional!"
    else
        write "  !!! SOME TESTS FAILED !!!"
        write "  Please review failures above."
    end if

    write ""
    write "============================================="

end program ultimate_nottran_test