! Test program 1: Lexical Showcase
! This program tests various tokens:
! - Keywords (program, integer, real, logical, character, write, end)
! - Names (lexical_test, i, r, l, c, a_long_name_123, j, k)
! - Literals (integer, real, logical, character, BOZ)
! - Comments (like this one)
! - Operators (=)

program lexical_test
    integer :: i, a_long_name_123, j, k
    logical :: l1, l2
    character :: c1, c2, c3

    ! Test simple integer literals
    i = 42
    a_long_name_123 = +123
    i = -876

    ! Test BOZ literals
    j = b"0110101000" ! Binary
    k = o"734502"     ! Octal
    i = z"af132cd"    ! Hexadecimal


    ! Test logical literals
    l1 = .true.
    l2 = .false.

    ! Test character literals
    c1 = "boop"
    c2 = "The name ""Ian"" is given to the most boring of programmers."
    c3 = "! This is not a comment"

    write c1, i ! This is an inline comment
end program lexical_test