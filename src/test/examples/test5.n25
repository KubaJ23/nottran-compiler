! Test program 4 (Corrected): Expressions and Operators
! Tests operator precedence, associativity, and all expression forms.
! The 'type complex_type' definition is now correctly at the top level.

type complex_type
    integer :: val
    integer(2) :: arr
end type complex_type

program expression_test
    integer :: a, b, c, d
    real :: x
    logical :: l1, l2, l3
    character :: s1, s2, s3
    type (complex_type) :: s

    ! Precedence: ** > * > +
    ! 1 + (2 * (3 ** 2)) = 1 + (2 * 9) = 19
    a = 1 + 2 * 3 ** 2

    ! Associativity: ** (Right), / (Left)
    ! 2 ** (3 ** 2) = 2 ** 9 = 512
    b = 2 ** 3 ** 2

    ! (8 / 4) / 2 = 2 / 2 = 1
    c = 8 / 4 / 2

    ! Parentheses
    d = (1 + 2) * 3 ! d = 9

    ! Field access and array indexing in expressions
    s % val = 10
    s % arr(0) = 5
    d = s % val * s % arr(0) ! d = 50

    ! Integer vs Real division
    x = 10.0 / 4.0 ! x = 2.5
    a = 10 / 4     ! a = 2 (floor)

    ! String concatenation
    s1 = "hello"
    s2 = "world"
    s3 = s1 // " " // s2 ! s3 = "hello world"

    ! Relational and Logical operators
    l1 = (a == 2) .and. (x > 2.0)                 ! .true.
    l2 = (b /= 512) .or. (c .gt. 1)              ! .false.
    l3 = (s3 .eq. "hello world") .and. (l1 .neq. l2) ! .true.

    write a, b, c, d, x, s3, l1, l2, l3
end program expression_test