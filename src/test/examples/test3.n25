! Test program 2 (Corrected): Structure and Declarations
! Tests definitions of program, subroutine, function (with and without result),
! and derived types.
! Type definitions are now correctly placed at the top level.

! Define a derived type (Program Unit)
type pixel
    integer :: r, g, b
end type pixel

! Define a type using the first type (Program Unit)
type screen
    type (pixel)(640, 480) :: buffer ! Array of derived type
    character :: name
end type screen

! Main program (Program Unit)
program structure_test
    ! Variable declarations using the globally defined types
    integer :: i
    real(10) :: a ! 1D array
    logical(4, 4) :: b ! 2D array
    type (pixel) :: p1
    type (screen) :: s1

    ! Pointer declarations
    integer pointer :: p_int
    real(*) pointer :: p_array_1d
    type (pixel)(*, *) pointer :: p_pixel_matrix

    ! Statements
    i = 1
    call setup(i)
    i = get_val(i)
    i = get_val_recursive(5)

end program structure_test

! Test subroutine definition (Program Unit)
subroutine setup(a)
    integer :: a
    write a
end subroutine setup

! Test function with default result variable (Program Unit)
function get_val(x)
    integer :: x, get_val
    get_val = x + 1
end function get_val

! Test function with explicit result variable (Program Unit)
function get_val_recursive(n) result(ans)
    integer :: n, ans
    if (n <= 1) then
        ans = 1
    else
        ans = n * get_val_recursive(n- 1)
    end if
end function get_val_recursive