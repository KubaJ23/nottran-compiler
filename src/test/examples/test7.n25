function fact(n) result(f)
    integer :: n, f
    if (n <= 1) then
        f = 1
    else
        f = n * fact(n - 1)
    end if
end function fact

subroutine build_table(n, arr)
    integer :: n
    integer(*) :: arr
    integer :: i
    do i = 0, n
        arr(i) = fact(i)
    end do
end subroutine build_table

subroutine print_table(arr, n)
    integer(*) :: arr
    integer :: i, n
    write "Factorials:"
    do i = 0, n
        write arr(i)
    end do
end subroutine print_table

program factorial_table
    integer(10) :: table
    integer :: size
    write "Enter table size (<=10):"
    read size
    call build_table(size, table)
    call print_table(table, size)
end program factorial_table
